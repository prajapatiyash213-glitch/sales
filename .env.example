# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. NEVER expose this in the browser or commit it.
# Used only by the admin "Invite member" and "Deactivate member" actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public URL of this app (used in invite / password-reset emails)
NEXT_PUBLIC_SITE_URL=https://your-sales-app.vercel.app
